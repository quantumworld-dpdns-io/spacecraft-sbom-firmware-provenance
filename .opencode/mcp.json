{
  "mcp_servers": {
    "sbom-provenance": {
      "type": "local",
      "command": "uvicorn",
      "args": ["sbom_provenance.main:app", "--host", "0.0.0.0", "--port", "8001"],
      "env": {
        "ENVIRONMENT": "development",
        "DATABASE_URL": "sqlite+aiosqlite:///./sbom_provenance.db",
        "SECRET_KEY": "mcp-server-secret-key-1234567890"
      },
      "description": "MCP server for Spacecraft SBOM and firmware provenance queries"
    },
    "sbom-search": {
      "type": "local",
      "command": "python",
      "args": ["-m", "sbom_provenance.api.mcp_search_server"],
      "env": {
        "VECTOR_DB_URL": "http://localhost:8001"
      },
      "description": "Vector search MCP server for SBOM semantic search"
    }
  },
  "tools": {
    "get_sbom": {
      "description": "Retrieve an SBOM document by ID",
      "inputSchema": {
        "type": "object",
        "properties": {
          "document_id": {
            "type": "string",
            "description": "UUID of the SBOM document"
          }
        },
        "required": ["document_id"]
      }
    },
    "search_sbom": {
      "description": "Search SBOM documents by name or organization",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "Search query string"
          }
        },
        "required": ["query"]
      }
    },
    "verify_firmware": {
      "description": "Verify firmware integrity using stored hashes",
      "inputSchema": {
        "type": "object",
        "properties": {
          "firmware_id": {
            "type": "string",
            "description": "UUID of the firmware image"
          }
        },
        "required": ["firmware_id"]
      }
    },
    "trace_provenance": {
      "description": "Trace the provenance chain for a target entity",
      "inputSchema": {
        "type": "object",
        "properties": {
          "target_type": {
            "type": "string",
            "description": "Type of target (firmware, sbom)"
          },
          "target_id": {
            "type": "string",
            "description": "UUID of the target"
          }
        },
        "required": ["target_type", "target_id"]
      }
    }
  }
}
