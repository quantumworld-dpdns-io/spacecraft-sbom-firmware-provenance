# Application
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=change-this-to-a-random-secret-in-production

# Database
DATABASE_URL=sqlite+aiosqlite:///./sbom_provenance.db
# For PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://sbom:sbom_secret@localhost:5432/sbom_provenance

# Redis
REDIS_URL=redis://localhost:6379/0

# API
API_HOST=0.0.0.0
API_PORT=8000

# Vector Database
VECTOR_DB_PROVIDER=chroma
VECTOR_DB_URL=http://localhost:8001
VECTOR_DB_COLLECTION=sbom_embeddings

# Storage
STORAGE_BACKEND=local
STORAGE_PATH=./data/sbom_storage

# Observability
WANDB_API_KEY=
WANDB_PROJECT=spacecraft-sbom-provenance

# AI Models
OLLAMA_BASE_URL=http://localhost:11434
OPENAI_API_KEY=
